# Secrets and local configuration — never bake these into the image.
.env
.env.*
!.env.example
*.pem
*.key

# Local data, backups and Paperless storage mounted at runtime.
data/
backups/
exports/
export/
media/
paperless-data/
paperless-media/
paperless-export/
paperless-consume/
ollama/

# Python and tooling artifacts.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Version control and macOS noise.
.git/
.gitignore
.DS_Store
*.textClipping
