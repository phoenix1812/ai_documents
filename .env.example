# AI Documents — copy to .env and replace every change-me value.
# cp .env.example .env && scripts/check-env.sh

# --- Paperless connection -----------------------------------------------------
# Internal URL used by the AI worker and the review UI (Docker network).
PAPERLESS_URL=http://paperless:8000
# URL humans use to open Paperless and the links in the review UI.
PAPERLESS_PUBLIC_URL=http://localhost:8000
# API token: Paperless -> Settings -> Administrative Tools -> API Tokens.
PAPERLESS_TOKEN=change-me-token

# --- AI classification --------------------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
# Context window for one classification request. The model default (4096 for
# gemma3) is smaller than a long OCR text, which cuts the JSON answer off.
# Raise it for big documents; every step costs CPU time and RAM.
OLLAMA_NUM_CTX=8192
# OCR characters sent to the model. Empty derives it from OLLAMA_NUM_CTX.
OCR_MAX_CHARS=
# Minimum confidence for writing metadata to Paperless without review.
CONFIDENCE_THRESHOLD=0.9
MIN_TITLE_LENGTH=8
# true = classify and report in the review UI, but never write to Paperless.
DRY_RUN=true

# --- Storage ------------------------------------------------------------------
# Directory for the AI SQLite database (documents.db), mounted at /data.
DB_PATH=/data
# Legacy path of an older single-file database; optional.
SQLITE_PATH=/data/documents.db

# --- PostgreSQL (Paperless) ---------------------------------------------------
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-postgres
PAPERLESS_DBHOST=db
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change-me-postgres

# --- Paperless first-run admin ------------------------------------------------
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me-admin
PAPERLESS_SECRET_KEY=change-me-secret

# --- Host paths (macOS/Linux) -------------------------------------------------
PAPERLESS_CONSUME_PATH=./paperless-consume
PAPERLESS_DATA_PATH=./paperless-data
PAPERLESS_MEDIA_PATH=./paperless-media
POSTGRES_DATA_PATH=./data/postgres
# Required > 0 for /Volumes/... or /mnt/... consume directories (Paperless v3 polling).
PAPERLESS_CONSUMER_POLLING_INTERVAL=10
PAPERLESS_CONSUMER_STABILITY_DELAY=5

# --- Review UI basic auth -----------------------------------------------------
REVIEW_UI_USERNAME=admin
REVIEW_UI_PASSWORD=change-me-review

# --- Persistent queue ---------------------------------------------------------
QUEUE_POLL_INTERVAL_SECONDS=2
QUEUE_MAX_ATTEMPTS=10
QUEUE_RETRY_BASE_SECONDS=30
QUEUE_RETRY_MAX_SECONDS=1800

# --- Reconciliation -----------------------------------------------------------
# Master switch for the periodic Paperless <-> AI database comparison.
RECONCILE_ENABLED=true
# false = the existing Paperless stock is never imported automatically; only
# documents created after the first start are picked up. Use
# scripts/reconcile_missing.sh for a deliberate bulk import.
RECONCILE_INITIAL_IMPORT=false
RECONCILIATION_INTERVAL_SECONDS=600
RECONCILIATION_START_DELAY_SECONDS=30

# --- Health checks ------------------------------------------------------------
HEALTHCHECK_TIMEOUT_SECONDS=3
